# Copy to .env and adjust. Never commit .env - it is git-ignored.

# --- Application ---
APP_NAME=BankAI
# development | test | ci | production
ENVIRONMENT=development

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json (machine-readable, default) | console (human-readable, local dev)
LOG_FORMAT=console

# --- Database ---
# Async SQLAlchemy URL for running the code on the host. (Inside docker compose the URL is
# set by the compose file: host "database". From the host, the compose database is on port 5433.)
DATABASE_URL=postgresql+asyncpg://bankai:bankai@localhost:5432/bankai
DATABASE_ECHO=false
# Used only by the integration tests (a separate database - it gets wiped).
TEST_DATABASE_URL=postgresql+asyncpg://bankai:bankai@localhost:5432/bankai_test

# --- Mock data ---
SEED_RANDOM_SEED=42

# --- MCP tool server ---
# Where the agent reaches the MCP server (with docker compose: http://mcp-server:8001/mcp).
MCP_SERVER_URL=http://localhost:8001/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8001
# Host headers the MCP server accepts (DNS-rebinding protection), as a JSON list.
MCP_ALLOWED_HOSTS=["localhost:*", "127.0.0.1:*"]
# REQUIRED. Shared secret for agent -> MCP principal tokens, at least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_SECRET=
MCP_TOKEN_TTL_SECONDS=60
TOOL_TIMEOUT_SECONDS=10

# --- LLM ---
# none = no LLM: rule-based routing + template answers (offline, free, deterministic).
# openai_compatible = any OpenAI-style chat API: a local Ollama (below) or OpenAI itself.
LLM_PROVIDER=openai_compatible
# Local Ollama (free, no key):  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5:3b
# OpenAI (paid key):            leave LLM_BASE_URL empty, LLM_MODEL=gpt-4.1-mini, set LLM_API_KEY
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=400

# --- RAG (knowledge base) ---
# hashing = offline lexical baseline (tests/CI) | openai_compatible = real embeddings
EMBEDDING_PROVIDER=openai_compatible
# Local Ollama (free): nomic-embed-text, 768 dimensions. Task prefixes are specific to nomic.
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_KEY=
EMBEDDING_QUERY_PREFIX="search_query: "
EMBEDDING_DOCUMENT_PREFIX="search_document: "
# pgvector = PostgreSQL (index with: python -m scripts.ingest_knowledge_base) | memory = indexed at startup
VECTOR_STORE=pgvector
RAG_TOP_K=4
# Leave empty to use the calibrated default for the embedder (python -m scripts.calibrate_rag)
RAG_MIN_SCORE=
KNOWLEDGE_BASE_DIR=knowledge_base

# --- Agent ---
# hybrid = rules first, LLM when rules are unsure | rules = never use the LLM to route | llm = always
ROUTER_MODE=hybrid
# llm = the LLM phrases answers (checked against the facts) | template = deterministic answers
RESPONSE_MODE=llm
MAX_MESSAGE_CHARS=1000

# --- API (uvicorn app.api.main:app) ---
# Signs the MOCK login sessions. Empty = a random secret per process (sessions end on restart);
# required in production. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SESSION_SECRET=
API_SESSION_TTL_MINUTES=60
# Enables the evaluation endpoints (X-Operator-Key header). Empty = disabled. At least 32 characters.
OPERATOR_API_KEY=
# in_process = the API runs the MCP tools itself | http = it calls the MCP server at MCP_SERVER_URL
MCP_TRANSPORT=in_process
CONVERSATION_TTL_MINUTES=30
# Extra browser origins allowed to call the API (JSON list); the bundled UI needs none
CORS_ORIGINS=[]

# --- Voice (optional: pip install -r requirements-voice.txt && python -m scripts.download_voice_models) ---
# Speech-to-text: none | faster_whisper (local Whisper, free) | openai_compatible (/audio/transcriptions)
STT_PROVIDER=faster_whisper
# faster_whisper: tiny | base | small | medium | large-v3 ...   OpenAI: whisper-1
STT_MODEL=small
STT_MODEL_DIR=models/whisper
STT_BASE_URL=
STT_API_KEY=
# STT_PROMPT (not set here) = banking vocabulary hint, English only (fixes 'lari' heard as 'lorry'); STT_PROMPT= disables it
# Below this transcript confidence the assistant asks to repeat instead of acting (python -m scripts.evaluate_voice)
STT_MIN_CONFIDENCE=0.5
# Text-to-speech: none | piper (local neural voices, incl. Georgian) | openai_compatible (/audio/speech)
TTS_PROVIDER=piper
TTS_VOICES_DIR=models/piper
TTS_VOICE_EN=en_US-lessac-medium
TTS_VOICE_KA=ka_GE-natia-medium
TTS_MODEL=gpt-4o-mini-tts
TTS_BASE_URL=
TTS_API_KEY=
VOICE_MAX_AUDIO_BYTES=10000000
VOICE_MAX_AUDIO_SECONDS=60
TTS_MAX_CHARS=1500

# --- Docker Compose (docker compose up; see docs/DOCKER.md) ---
# Read by docker-compose.yml, not by the application. The containers do NOT use the LLM,
# database or voice settings above: the stack runs offline by default, and the add-on files
# docker-compose.ollama.yml / docker-compose.voice.yml switch features on.
# The three secrets above (MCP_AUTH_SECRET, API_SESSION_SECRET, OPERATOR_API_KEY) are
# generated on first start into the "secrets" volume; values set here replace them.
#   Operator key for the dashboard: docker compose exec backend cat /var/lib/bankai/secrets/operator_api_key
POSTGRES_USER=bankai
# A local default for MOCK data on 127.0.0.1 only - change it for anything else.
POSTGRES_PASSWORD=bankai
POSTGRES_DB=bankai
# Host ports (both bound to 127.0.0.1). 5433 avoids a local PostgreSQL on 5432.
POSTGRES_PORT=5433
BACKEND_PORT=8000
# Where the containers find Ollama with docker-compose.ollama.yml (the host by default)
OLLAMA_URL=http://host.docker.internal:11434

